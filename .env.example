# Copy to .env and fill in. .env is gitignored — never commit the real file.
#
# Leave these blank to run in localStorage mode. The app works fully without
# them; adding them upgrades storage to Supabase with no code change.
#
# Only the ANON key belongs in a browser app. The service_role key bypasses
# row-level security and must never appear in client code or in this repo.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
